---
interface Props {
  id?: string;
  n?: string;
  label: string;
  title: string;
  as?: 'h1' | 'h2';
}
const { id, n, label, title, as: Tag = 'h2' } = Astro.props;
---

<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
  <div>
    <p class="label" data-reveal>{n && <span class="text-fg">{n} — </span>}{label}</p>
    <Tag id={id} class="display mt-4 max-w-4xl text-[clamp(2.5rem,9vw,5.5rem)]" data-reveal style="--d:.08s">{title}</Tag>
  </div>
  <slot />
</div>
