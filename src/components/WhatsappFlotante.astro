---
import { t, type Lang } from '../i18n/ui';
import { persona } from '../data/sitio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const href = `https://wa.me/${persona.whatsapp}?text=${encodeURIComponent(tr('contact.whatsappMsg'))}`;
---

<!-- Solo en móvil: aparece al pasar el hero y se esconde cuando la sección de contacto está en pantalla. -->
<a
  href={href}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-40 inline-flex h-14 items-center gap-2 rounded-full bg-[#25d366] pr-5 pl-4 font-semibold text-[#06260f] shadow-lg shadow-black/30 transition-[transform,opacity] duration-500 ease-fluid md:hidden"
  style="transform: translateY(150%); opacity: 0"
  aria-label="WhatsApp"
  data-wa-flotante
  data-umami-event="whatsapp"
  data-umami-event-ubicacion="flotante"
>
  <svg viewBox="0 0 24 24" class="size-6" fill="currentColor" aria-hidden="true">
    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"></path>
  </svg>
  WhatsApp
</a>

<script>
  const boton = document.querySelector<HTMLElement>('[data-wa-flotante]')!;
  const contacto = document.querySelector('#contacto, #contact');
  let contactoVisible = false;
  const actualizar = () => {
    const mostrar = scrollY > innerHeight * 0.7 && !contactoVisible;
    boton.style.transform = mostrar ? '' : 'translateY(150%)';
    boton.style.opacity = mostrar ? '1' : '0';
    boton.tabIndex = mostrar ? 0 : -1;
  };
  if (contacto) {
    new IntersectionObserver(([e]) => {
      contactoVisible = e.isIntersecting;
      actualizar();
    }).observe(contacto);
  }
  addEventListener('scroll', actualizar, { passive: true });
  actualizar();
</script>
