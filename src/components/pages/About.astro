---
import fs from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import SectionHead from '../SectionHead.astro';
import Contact from '../Contact.astro';
import PrincipleVisual from '../PrincipleVisual.astro';
import { ruta, t, type Lang } from '../../i18n/ui';
import { persona } from '../../data/sitio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const otro: Lang = lang === 'es' ? 'en' : 'es';
// El botón del CV solo aparece cuando el PDF existe en public/.
const cv = persona.cv[lang];
const hayCv = fs.existsSync(`${process.cwd()}/public${cv}`);

const es = lang === 'es';
const anios = new Date().getFullYear() - persona.desde;

const bloques = es
  ? [
      { t: 'Web', items: ['TypeScript', 'Astro', 'Next.js', 'React', 'Tailwind CSS', 'three.js', 'GSAP', 'Vite'] },
      { t: 'Backend y datos', items: ['Node.js', 'ASP.NET Core', 'PostgreSQL', 'Drizzle', 'EF Core', 'Redis', 'SignalR', 'pg-boss'] },
      { t: '3D y juegos', items: ['Unity 6', 'C#', 'FishNet', 'Blender', 'Manifold (WASM)', 'three-mesh-bvh'] },
      { t: 'Infra y calidad', items: ['Docker', 'Dokploy', 'AWS', 'Google Cloud Platform', 'Cloudflare Workers', 'Kapso', 'GitHub Actions', 'Vitest', 'xUnit', 'Playwright'] },
      { t: 'IA', items: ['Anthropic', 'OpenAI', 'Gemini', 'Agentes de código'] },
    ]
  : [
      { t: 'Web', items: ['TypeScript', 'Astro', 'Next.js', 'React', 'Tailwind CSS', 'three.js', 'GSAP', 'Vite'] },
      { t: 'Backend & data', items: ['Node.js', 'ASP.NET Core', 'PostgreSQL', 'Drizzle', 'EF Core', 'Redis', 'SignalR', 'pg-boss'] },
      { t: '3D & games', items: ['Unity 6', 'C#', 'FishNet', 'Blender', 'Manifold (WASM)', 'three-mesh-bvh'] },
      { t: 'Infra & quality', items: ['Docker', 'Dokploy', 'AWS', 'Google Cloud Platform', 'Cloudflare Workers', 'Kapso', 'GitHub Actions', 'Vitest', 'xUnit', 'Playwright'] },
      { t: 'AI', items: ['Anthropic', 'OpenAI', 'Gemini', 'Coding agents'] },
    ];

const principios = es
  ? [
      ['Producto completo', 'Del modelo de datos a la interfaz, el servidor y el despliegue. Una sola persona responsable de que todo funcione junto.'],
      ['Datos que no se rompen', 'Transacciones, idempotencia, bitácoras de auditoría y pruebas contra bases reales. El dinero y las recetas no admiten errores.'],
      ['Primero el teléfono', 'La mayoría de tus clientes te van a ver desde el celular. Diseño y mido ahí antes que en escritorio.'],
    ]
  : [
      ['The whole product', 'From the data model to the interface, the server and the deploy. One person accountable for everything working together.'],
      ["Data that doesn't break", 'Transactions, idempotency, audit logs and tests against real databases. Money and prescriptions leave no room for mistakes.'],
      ['Phone first', 'Most of your customers will see you on their phone. I design and measure there before desktop.'],
    ];
---

<Layout lang={lang} title={tr('about.metaTitle')} description={tr('meta.description')} alt={ruta(otro, 'about')}>
  <section class="container-x pt-32 pb-16 md:pt-44">
    <SectionHead as="h1" label={tr('about.label')} title={tr('about.title')} />
    <div class="mt-10 grid gap-10 md:grid-cols-[1.2fr_1fr] md:gap-16">
      <div class="prose-x" data-reveal>
        {
          es ? (
            <>
              <p class="text-xl text-fg">
                Soy desarrollador full-stack con {anios} años de experiencia profesional (desde {persona.desde}).
                Actualmente trabajo como <strong>{persona.trabajo.puesto}</strong> en{' '}
                <strong>{persona.trabajo.empresa}</strong>, en {persona.trabajo.ciudad}.
              </p>
              <p>
                Mi fuerte es llevar una funcionalidad de punta a punta: modelo de datos, API, interfaz, pruebas y
                despliegue. En frontend trabajo con TypeScript, React y Next.js; en backend con Node.js, C#/.NET y
                PostgreSQL; y en infraestructura con Docker, AWS y Google Cloud.
              </p>
              <p>
                Me importa que el código se pueda mantener y que no rompa datos: pruebas contra bases reales,
                transacciones donde hay dinero de por medio, documentación clara y revisiones de código. Uso agentes de IA
                a diario en mi flujo de desarrollo, con criterio para revisar y probar lo que generan.
              </p>
              <p>
                Fuera de mi empleo construyo productos propios, de sistemas para negocios a un videojuego multijugador,
                y dirijo{' '}
                <a href={persona.empresa.url} target="_blank" rel="noopener">
                  {persona.empresa.nombre}
                </a>
                , donde hago consultoría de software e IA.
              </p>
            </>
          ) : (
            <>
              <p class="text-xl text-fg">
                I'm a full-stack developer with {anios} years of professional experience (since {persona.desde}).
                I currently work as a <strong>{persona.trabajo.puesto}</strong> at{' '}
                <strong>{persona.trabajo.empresa}</strong>, in {persona.trabajo.ciudad}.
              </p>
              <p>
                My strength is taking a feature end to end: data model, API, interface, tests and deployment. On the
                frontend I work with TypeScript, React and Next.js; on the backend with Node.js, C#/.NET and PostgreSQL;
                and on infrastructure with Docker, AWS and Google Cloud.
              </p>
              <p>
                I care about code that stays maintainable and never corrupts data: tests against real databases,
                transactions wherever money is involved, clear documentation and code reviews. I use AI coding agents
                every day, with the judgment to review and test what they produce.
              </p>
              <p>
                Outside my job I build my own products, from business software to a multiplayer game, and I run{' '}
                <a href={persona.empresa.url} target="_blank" rel="noopener">
                  {persona.empresa.nombre}
                </a>
                , where I do software and AI consulting.
              </p>
            </>
          )
        }
        {/* PREGUNTA: formación y trabajos anteriores, para el CV. */}
      </div>
      <aside class="flex flex-col gap-3 self-start" data-reveal style="--d:.1s">
        <div class="rounded-2xl border border-accent/40 bg-accent/5 p-5">
          <p class="label flex items-center gap-2">
            <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-accent-2 opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-accent-2"></span></span>
            {tr('about.job')}
          </p>
          <p class="mt-3 font-display text-2xl font-bold tracking-tight">{persona.trabajo.puesto}</p>
          <p class="mt-1 text-fg/80">
            {es ? 'en' : 'at'} <strong class="font-semibold text-fg">{persona.trabajo.empresa}</strong> · {persona.trabajo.ciudad}
          </p>
        </div>
        {
          hayCv && (
            <a href={cv} class="btn btn-primary" download data-umami-event="descargar-cv" data-umami-event-idioma={lang}>
              {tr('about.cv')} ↓
            </a>
          )
        }
        <a href={persona.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn ↗</a>
        <a href={persona.github} target="_blank" rel="noopener" class="btn btn-ghost">GitHub ↗</a>
        <div class="mt-4 rounded-2xl border border-line p-5">
          <p class="label">{tr('about.now')}</p>
          <p class="mt-3 text-sm text-fg/80">
            {
              es
                ? 'En mis tiempos libres: llevando Orion Galaxy a su siguiente versión y tomando proyectos de webs y sistemas.'
                : 'On the side: taking Orion Galaxy to its next release and taking on website and software projects.'
            }
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-px overflow-hidden rounded-3xl border border-line bg-line md:grid-cols-3">
      {
        principios.map(([titulo, texto], i) => (
          <div class="group bg-bg p-6 transition-colors hover:bg-bg-2 md:p-8" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="font-mono text-xs text-accent">0{i + 1}</span>
            <div class="mt-4">
              <PrincipleVisual tipo={(['producto', 'datos', 'movil'] as const)[i]} />
            </div>
            <h2 class="mt-6 font-display text-2xl font-bold tracking-tight">{titulo}</h2>
            <p class="mt-3 text-fg/70">{texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-x py-16 md:py-24">
    <p class="label">{tr('about.stack')}</p>
    <div class="mt-8 flex flex-col">
      {
        bloques.map((b) => (
          <div class="grid gap-4 border-t border-line py-6 md:grid-cols-[14rem_1fr]" data-reveal>
            <h3 class="font-display text-xl font-bold">{b.t}</h3>
            <div class="flex flex-wrap gap-2">
              {b.items.map((i) => (
                <span class="chip !text-sm">{i}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <Contact lang={lang} />
</Layout>
