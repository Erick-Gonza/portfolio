---
import Layout from '../../layouts/Layout.astro';
import SectionHead from '../SectionHead.astro';
import ProjectRow from '../ProjectRow.astro';
import Contact from '../Contact.astro';
import { ruta, t, type Lang } from '../../i18n/ui';
import { proyectos } from '../../data/contenido';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const lista = await proyectos(lang);
---

<Layout lang={lang} title={tr('projects.title')} description={tr('projects.intro')} alt={ruta(lang === 'es' ? 'en' : 'es', 'projects')}>
  <section class="pt-32 pb-12 md:pt-44">
    <div class="container-x">
      <SectionHead as="h1" label={tr('projects.label')} title={tr('projects.title')} />
      <p class="mt-6 max-w-xl text-lg text-fg/75" data-reveal>{tr('projects.intro')}</p>
    </div>
    <ol class="mt-14 border-t border-line">
      {lista.map((p, i) => <ProjectRow proyecto={p} lang={lang} index={i} />)}
    </ol>
  </section>
  <Contact lang={lang} />
</Layout>
