---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { ruta, t, type Lang } from '../../i18n/ui';
import { fecha, minutosLectura, slugDe, slugTag, traduccion, type Post } from '../../data/contenido';
import { persona } from '../../data/sitio';

interface Props {
  lang: Lang;
  post: Post;
}
const { lang, post } = Astro.props;
const tr = t(lang);
const d = post.data;
const slug = slugDe(post);
const { Content, headings } = await render(post);
const indice = headings.filter((h) => h.depth === 2);
const otro: Lang = lang === 'es' ? 'en' : 'es';
const hayTraduccion = !!(await traduccion('blog', slug, otro));
const alt = hayTraduccion ? ruta(otro, 'blog', slug) : ruta(otro, 'blog');

const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: persona.nombre, url: Astro.site?.href },
  keywords: d.tags.join(', '),
};
---

<Layout lang={lang} title={d.title} description={d.description} alt={alt} type="article" jsonLd={ld}>
  <article class="container-x pt-32 pb-24 md:pt-44">
    <header class="max-w-4xl">
      <a href={ruta(lang, 'blog')} class="label hover:text-fg">← {tr('blog.back')}</a>
      <h1 class="display mt-6 text-[clamp(2.5rem,9vw,5.5rem)]" data-pagefind-meta="title">{d.title}</h1>
      <p class="mt-6 max-w-2xl text-xl text-fg/80">{d.description}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3 font-mono text-xs text-muted">
        <time datetime={d.date.toISOString()}>{fecha(d.date, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutosLectura(post.body)} {tr('blog.readTime')}</span>
        {d.tags.map((tg) => <a href={ruta(lang, 'tags', slugTag(tg))} class="chip hover:border-fg hover:text-fg">#{tg}</a>)}
      </div>
      {
        hayTraduccion && (
          <a href={alt} hreflang={otro} class="mt-6 inline-block text-sm text-accent underline underline-offset-4">
            {tr('blog.otherLang')} →
          </a>
        )
      }
    </header>
    <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16">
      <div class="lg:order-2">
        {
          indice.length > 1 && (
            <nav aria-label={tr('blog.toc')} class="lg:sticky lg:top-24">
              <details class="group rounded-2xl border border-line p-4 lg:border-0 lg:p-0" open>
                <summary class="label flex min-h-8 cursor-pointer list-none items-center justify-between lg:cursor-default">
                  {tr('blog.toc')}
                  <span class="transition-transform group-open:rotate-180 lg:hidden" aria-hidden="true">
                    ▾
                  </span>
                </summary>
                <ol class="mt-3 flex flex-col border-l border-line">
                  {indice.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="-ml-px flex min-h-8 items-center border-l border-transparent py-1 pl-4 text-sm text-fg/70 hover:border-fg hover:text-fg"
                        data-toc-link
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            </nav>
          )
        }
      </div>
      <div class="prose-x lg:order-1" data-pagefind-body>
        <Content />
      </div>
    </div>
  </article>
</Layout>

<script>
  // Marca en el índice la sección que se está leyendo.
  const enlaces = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
  );
  if (enlaces.size) {
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          enlaces.forEach((a) => a.classList.remove('!border-accent', '!text-fg'));
          enlaces.get(e.target.id)?.classList.add('!border-accent', '!text-fg');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    enlaces.forEach((_, id) => {
      const h = document.getElementById(id);
      if (h) io.observe(h);
    });
  }
</script>
