---
// Mini ilustraciones de cada servicio (SVG con los colores del tema). Se animan al pasar el cursor por la tarjeta y,
// en el caso del 3D, de forma continua y lenta. Con reduced-motion las animaciones se apagan (global.css).
interface Props {
  tipo: 'web' | 'apps' | '3d' | 'ia';
  lang?: 'es' | 'en';
}
const { tipo, lang = 'es' } = Astro.props;
const txt =
  lang === 'es'
    ? { ventas: 'VENTAS', citas: 'CITAS HOY', cliente: '¿Tienen cita el jueves?', agente: 'Sí, 11:00 o 16:30.', agendado: 'Agendado ✓' }
    : { ventas: 'SALES', citas: 'TODAY', cliente: 'Any slot on Thursday?', agente: 'Yes, 11:00 or 4:30.', agendado: 'Booked ✓' };

// Icosaedro proyectado (vista frontal): contorno hexagonal y triángulos internos.
const R = 46;
const hex = Array.from({ length: 6 }, (_, i) => {
  const a = (Math.PI / 3) * i - Math.PI / 2;
  return [Math.cos(a) * R, Math.sin(a) * R];
});
const inner = Array.from({ length: 3 }, (_, i) => {
  const a = ((Math.PI * 2) / 3) * i - Math.PI / 2 + Math.PI / 3;
  return [Math.cos(a) * R * 0.5, Math.sin(a) * R * 0.5];
});
const lineasIco: [number[], number[]][] = [];
for (let i = 0; i < 6; i++) lineasIco.push([hex[i], hex[(i + 1) % 6]]);
for (let i = 0; i < 3; i++) lineasIco.push([inner[i], inner[(i + 1) % 3]]);
inner.forEach((p, i) => {
  lineasIco.push([p, hex[(i * 2 + 1) % 6]], [p, hex[(i * 2) % 6]], [p, hex[(i * 2 + 2) % 6]]);
});
const barras = [38, 56, 44, 70, 52, 84, 66];
---

<div class="service-visual relative h-36 w-full md:h-40" aria-hidden="true">
  {
    tipo === 'web' && (
      <svg viewBox="0 0 260 150" class="size-full" fill="none">
        {/* Navegador */}
        <rect x="2" y="10" width="190" height="128" rx="10" class="fill-bg-2 stroke-line" stroke-width="1.5" />
        <circle cx="16" cy="24" r="3" class="fill-accent" />
        <circle cx="27" cy="24" r="3" class="fill-muted/40" />
        <circle cx="38" cy="24" r="3" class="fill-muted/40" />
        <rect x="52" y="19" width="110" height="10" rx="5" class="fill-line" />
        <rect x="16" y="44" width="96" height="12" rx="3" class="sv-grow fill-fg/85" />
        <rect x="16" y="62" width="70" height="12" rx="3" class="fill-accent" />
        <rect x="16" y="84" width="120" height="5" rx="2.5" class="fill-muted/40" />
        <rect x="16" y="94" width="100" height="5" rx="2.5" class="fill-muted/40" />
        <rect x="16" y="112" width="44" height="14" rx="7" class="fill-accent" />
        {/* Teléfono encima */}
        <g class="sv-float">
          <rect x="168" y="34" width="68" height="112" rx="12" class="fill-bg stroke-fg/60" stroke-width="1.5" />
          <rect x="190" y="40" width="24" height="4" rx="2" class="fill-line" />
          <rect x="178" y="54" width="48" height="8" rx="2" class="fill-fg/85" />
          <rect x="178" y="66" width="34" height="8" rx="2" class="fill-accent" />
          <rect x="178" y="82" width="48" height="4" rx="2" class="fill-muted/40" />
          <rect x="178" y="90" width="40" height="4" rx="2" class="fill-muted/40" />
          <rect x="178" y="122" width="48" height="12" rx="6" class="fill-accent" />
        </g>
        {/* Puntuación de rendimiento */}
        <g transform="translate(232 22)">
          <circle r="17" class="fill-bg stroke-line" stroke-width="3" />
          <circle r="17" class="sv-ring stroke-accent-2" stroke-width="3" stroke-linecap="round" transform="rotate(-90)" pathLength="100" stroke-dasharray="100" />
          <text y="4" text-anchor="middle" class="fill-fg font-mono text-[11px]">100</text>
        </g>
      </svg>
    )
  }
  {
    tipo === 'apps' && (
      <svg viewBox="0 0 260 150" class="size-full" fill="none">
        <rect x="2" y="6" width="256" height="138" rx="10" class="fill-bg-2 stroke-line" stroke-width="1.5" />
        {/* Barra lateral */}
        <rect x="2" y="6" width="44" height="138" rx="10" class="fill-bg" />
        <rect x="14" y="20" width="20" height="20" rx="5" class="fill-accent" />
        {[52, 70, 88, 106].map((y) => <rect x="14" y={y} width="20" height="5" rx="2.5" class="fill-muted/40" />)}
        {/* KPIs */}
        <rect x="58" y="18" width="88" height="34" rx="6" class="fill-bg" />
        <text x="66" y="32" class="fill-muted font-mono text-[8px]">{txt.ventas}</text>
        <text x="66" y="46" class="fill-fg font-mono text-[12px]">$48.2k</text>
        <text x="116" y="46" class="fill-accent-2 font-mono text-[9px]">+24%</text>
        <rect x="154" y="18" width="92" height="34" rx="6" class="fill-bg" />
        <text x="162" y="32" class="fill-muted font-mono text-[8px]">{txt.citas}</text>
        <text x="162" y="46" class="fill-fg font-mono text-[12px]">12</text>
        <circle cx="232" cy="35" r="5" class="fill-accent" />
        {/* Gráfica de barras */}
        <line x1="58" y1="132" x2="246" y2="132" class="stroke-line" stroke-width="1" />
        {
          barras.map((h, i) => (
            <rect
              x={64 + i * 26}
              y={132 - h}
              width="16"
              height={h}
              rx="3"
              class:list={['sv-bar', i === 5 ? 'fill-accent' : 'fill-fg/25']}
              style={`--i:${i}`}
            />
          ))
        }
      </svg>
    )
  }
  {
    tipo === '3d' && (
      <svg viewBox="0 0 260 150" class="size-full" fill="none">
        {/* Rejilla en perspectiva */}
        <g class="stroke-line" stroke-width="1">
          {[-120, -80, -40, 0, 40, 80, 120].map((x) => <line x1={130 + x * 0.35} y1="108" x2={130 + x * 1.2} y2="148" />)}
          {[112, 122, 134, 148].map((y) => <line x1="0" y1={y} x2="260" y2={y} />)}
        </g>
        {/* Órbita y luna */}
        <ellipse cx="130" cy="66" rx="104" ry="24" class="stroke-muted/40" stroke-width="1.2" stroke-dasharray="3 5" transform="rotate(-12 130 66)" />
        {/* Planeta low-poly en alambre */}
        <g transform="translate(130 66)">
          <g class="sv-spin">
            <polygon points={hex.map((p) => p.join(',')).join(' ')} class="fill-accent/15" />
            {lineasIco.map(([a, b]) => <line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} class="stroke-accent" stroke-width="1.4" />)}
            {[...hex, ...inner].map((p) => <circle cx={p[0]} cy={p[1]} r="2.2" class="fill-fg" />)}
          </g>
        </g>
        <g class="sv-orbit">
          <circle r="7" class="fill-accent-2" />
        </g>
        <text x="8" y="16" class="fill-muted font-mono text-[9px]">60 FPS</text>
        <text x="252" y="16" text-anchor="end" class="fill-muted font-mono text-[9px]">PING 32ms</text>
      </svg>
    )
  }
  {
    tipo === 'ia' && (
      <svg viewBox="0 0 260 150" class="size-full" fill="none">
        {/* Conversación */}
        <rect x="2" y="6" width="150" height="138" rx="12" class="fill-bg-2 stroke-line" stroke-width="1.5" />
        <g class="sv-msg" style="--i:0">
          <rect x="12" y="18" width="112" height="24" rx="10" class="fill-bg stroke-line" />
          <text x="20" y="34" class="fill-fg/80 text-[8.5px]">{txt.cliente}</text>
        </g>
        <g class="sv-msg" style="--i:1">
          <rect x="34" y="50" width="108" height="24" rx="10" class="fill-accent" />
          <text x="42" y="66" class="fill-on-accent text-[8.5px] font-semibold">{txt.agente}</text>
        </g>
        <g class="sv-msg" style="--i:2">
          <rect x="34" y="82" width="70" height="20" rx="10" class="fill-accent-2/20 stroke-accent-2" />
          <text x="44" y="96" class="fill-fg text-[8.5px]">{txt.agendado}</text>
        </g>
        <g class="sv-typing">
          <circle cx="22" cy="126" r="3" class="fill-muted" />
          <circle cx="32" cy="126" r="3" class="fill-muted" />
          <circle cx="42" cy="126" r="3" class="fill-muted" />
        </g>
        {/* Flujo: agente → sistemas */}
        <path d="M152 75 C 175 75, 175 32, 198 32" class="stroke-line" stroke-width="1.5" />
        <path d="M152 75 L 198 75" class="stroke-line" stroke-width="1.5" />
        <path d="M152 75 C 175 75, 175 118, 198 118" class="stroke-line" stroke-width="1.5" />
        <circle r="3" class="sv-pulso fill-accent" />
        <g transform="translate(152 75)">
          <circle r="13" class="fill-bg stroke-accent" stroke-width="2" />
          <path d="M0 -6 L1.8 -1.8 L6 0 L1.8 1.8 L0 6 L-1.8 1.8 L-6 0 L-1.8 -1.8 Z" class="fill-accent" />
        </g>
        {[['CRM', 32], [lang === 'es' ? 'AGENDA' : 'CALENDAR', 75], ['EMAIL', 118]].map(([label, y]) => (
          <g>
            <rect x="198" y={Number(y) - 12} width="58" height="24" rx="6" class="fill-bg-2 stroke-line" stroke-width="1.5" />
            <text x="227" y={Number(y) + 3} text-anchor="middle" class="fill-muted font-mono text-[8px]">{label}</text>
          </g>
        ))}
      </svg>
    )
  }
</div>

<style>
  .service-visual :global(.sv-grow) {
    transform-box: fill-box;
    transform-origin: left;
    transition: transform 0.8s var(--ease-fluid);
  }
  :global(.group:hover) .service-visual :global(.sv-grow) {
    transform: scaleX(0.7);
  }
  .service-visual :global(.sv-float) {
    transition: transform 0.8s var(--ease-fluid);
  }
  :global(.group:hover) .service-visual :global(.sv-float) {
    transform: translateY(-8px);
  }
  .service-visual :global(.sv-ring) {
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 1.4s var(--ease-fluid);
  }
  :global(.is-in) .service-visual :global(.sv-ring),
  :root:not(.js) .service-visual :global(.sv-ring) {
    stroke-dashoffset: 0;
  }

  .service-visual :global(.sv-bar) {
    transform-box: fill-box;
    transform-origin: bottom;
    transform: scaleY(0.35);
    transition: transform 0.9s var(--ease-fluid);
    transition-delay: calc(var(--i) * 60ms);
  }
  :global(.is-in) .service-visual :global(.sv-bar),
  :root:not(.js) .service-visual :global(.sv-bar) {
    transform: scaleY(1);
  }
  :global(.group:hover) .service-visual :global(.sv-bar) {
    transform: scaleY(calc(0.75 + mod(var(--i), 3) * 0.15));
  }

  .service-visual :global(.sv-spin) {
    animation: sv-spin 24s linear infinite;
  }
  :global(.group:hover) .service-visual :global(.sv-spin) {
    animation-duration: 8s;
  }
  @keyframes sv-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .service-visual :global(.sv-orbit) {
    offset-path: path('M 28 88 A 104 24 -12 1 1 232 44 A 104 24 -12 1 1 28 88');
    animation: sv-orbit 9s linear infinite;
  }
  @keyframes sv-orbit {
    to {
      offset-distance: 100%;
    }
  }
  .service-visual :global(.sv-msg) {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.6s var(--ease-fluid),
      transform 0.6s var(--ease-fluid);
    transition-delay: calc(var(--i) * 350ms + 0.2s);
  }
  :global(.is-in) .service-visual :global(.sv-msg),
  :root:not(.js) .service-visual :global(.sv-msg) {
    opacity: 1;
    transform: none;
  }
  .service-visual :global(.sv-typing circle) {
    animation: sv-typing 1.2s ease-in-out infinite;
  }
  .service-visual :global(.sv-typing circle:nth-child(2)) {
    animation-delay: 0.15s;
  }
  .service-visual :global(.sv-typing circle:nth-child(3)) {
    animation-delay: 0.3s;
  }
  @keyframes sv-typing {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  .service-visual :global(.sv-pulso) {
    offset-path: path('M152 75 C 175 75, 175 32, 198 32');
    animation: sv-pulso 2.4s var(--ease-fluid) infinite;
  }
  @keyframes sv-pulso {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }
</style>
